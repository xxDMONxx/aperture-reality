<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/aperture_side_panel_bg"
    android:padding="12dp">

    <!-- DISTANCE LABEL -->
    <TextView
        android:id="@+id/txt_distance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="DISTANCIA"
        android:textColor="@color/fog"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- ACERCAR (CLOSER / ZOOM IN) -->
    <ImageView
        android:id="@+id/btn_distance_closer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="14dp"
        android:src="@drawable/ic_aperture_zoom_in"
        android:background="@drawable/aperture_button_bg"
        android:contentDescription="Acercar pantalla"
        android:focusable="true"
        android:clickable="true" />

    <View
        android:layout_width="36dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/steel" />

    <!-- ALEJAR (FURTHER / ZOOM OUT) -->
    <ImageView
        android:id="@+id/btn_distance_further"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="14dp"
        android:src="@drawable/ic_aperture_zoom_out"
        android:background="@drawable/aperture_button_bg"
        android:contentDescription="Alejar pantalla"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
